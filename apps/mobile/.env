# Build-time feature flags for Spider Privacy Browser.
# Inlined by react-native-dotenv at compile time (see babel.config.js) — these
# are NOT runtime secrets. Runtime, user-facing preferences live in settingsStore.
#
# PRIVACY_JS_ENABLED     master BUILD switch for the injected hardening bundle.
#                        false => the fingerprint bundle is never injected, even
#                        if the user's shield toggle is on. For debugging only.
# CONTENT_BLOCKING_ENABLED master BUILD switch for tracker request blocking
#                        (in-page blocker + navigation blocklist).
# DEFAULT_DOH_PROVIDER   default encrypted-DNS provider id (see @spider/network
#                        DOH_PROVIDERS). Seeds settingsStore.dohProvider; the
#                        user can still change it in Settings.
# GECKOVIEW_ENABLED      dev kill-switch for the GeckoView engine. The engine is
#                        actually chosen by the Android build FLAVOR (standard =
#                        WebView, gecko = GeckoView; see docs/GECKOVIEW.md), so this
#                        shared value stays true ("use GeckoView if the build has
#                        it"). Set false to force the WebView even in a gecko build.
PRIVACY_JS_ENABLED=true
CONTENT_BLOCKING_ENABLED=true
DEFAULT_DOH_PROVIDER=mullvad
GECKOVIEW_ENABLED=true
