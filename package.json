{
  "name": "spider-privacy-browser",
  "version": "0.0.9",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "android": "npm run android --workspace apps/mobile",
    "ios": "npm run ios --workspace apps/mobile",
    "start": "npm run start --workspace apps/mobile",
    "lint": "npm run lint --workspace apps/mobile",
    "test": "npm test --workspace apps/mobile",
    "publish:release": "node scripts/publish-release.mjs",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
