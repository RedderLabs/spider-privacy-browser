# Release signing template.
#
# Copy this file to  android/keystore.properties  (which is gitignored) and fill
# in your own upload key. NEVER commit the real keystore or the filled-in file.
#
# Generate an upload key (once):
#   keytool -genkeypair -v \
#     -keystore android/app/spider-release.keystore \
#     -alias spider -keyalg RSA -keysize 2048 -validity 10000
#
# `storeFile` is resolved relative to  android/app/  (like the debug keystore).
storeFile=spider-release.keystore
storePassword=CHANGE_ME
keyAlias=spider
keyPassword=CHANGE_ME
