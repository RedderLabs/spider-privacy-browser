+    // Spider Privacy Browser: native subresource tracker blocking. A blocker is
+    // registered at runtime by the app (dependency direction stays app -> library;
+    // this module never references app classes). The in-page JS blocker only covers
+    // fetch/XHR/sendBeacon; this stops EVERY blocked-host subresource before it
+    // reaches the network. Main-frame navigations are never blocked, and any
+    // failure falls through to normal loading.
+    public interface SubresourceBlocker {
+        boolean shouldBlock(String url);
+    }
+
+    public static volatile SubresourceBlocker sSubresourceBlocker;
+
+    @Override
+    public WebResourceResponse shouldInterceptRequest(WebView view, WebResourceRequest request) {
+        try {
+            SubresourceBlocker blocker = sSubresourceBlocker;
+            if (blocker != null
+                    && request != null
+                    && !request.isForMainFrame()
+                    && request.getUrl() != null
+                    && blocker.shouldBlock(request.getUrl().toString())) {
+                return new WebResourceResponse(
+                        "text/plain", "utf-8", new java.io.ByteArrayInputStream(new byte[0]));
+            }
+        } catch (Throwable t) {
+            // Never let blocking break a page load.
+        }
+        return super.shouldInterceptRequest(view, request);
+    }
